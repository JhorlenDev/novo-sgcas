# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env no repositorio.

# --- Django ---
DEBUG=True
# Atras do Next, o Host que chega aqui e o de SGCAS_API_URL (o Next o troca):
# em producao continue com localhost, nao com o dominio publico.
ALLOWED_HOSTS=localhost,127.0.0.1
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHAVE_SECRETA_AQUI

# --- Banco de dados ---
DATABASE_URL=postgresql://sgcas:change-me@localhost:5434/sgcas

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Proxies ---
# Quantos proxies reversos (nginx etc., na frente do Next) acrescentam o IP do
# cliente ao X-Forwarded-For. O Next nao acrescenta. Define de onde vem o IP no
# limite de requisicoes e na auditoria. Se omitido: 0 com DEBUG=True e 1 com
# DEBUG=False. Defina 2 se houver balanceador alem do nginx. Se for maior que o
# real, o IP vira falsificavel; se for menor, vira o IP de um proxy.
# TRUSTED_PROXIES=1

# --- Armazenamento ---
LOCAL_STORAGE_PATH=armazenamento

# --- Keycloak (Tefe Cidadao) ---
KEYCLOAK_URL=https://sso.tefe.am.gov.br
KEYCLOAK_REALM=prefeitura
KEYCLOAK_CLIENT_ID=sgcas-web
KEYCLOAK_CLIENT_SECRET=SEGREDO_CLIENTE_AQUI
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback

# --- Entrada de desenvolvimento (DEV-LOGIN, TEMPORARIO) ---
# Entra sem Keycloak, escolhendo perfil e unidade em http://localhost:3000/api/auth/dev
# So funciona com DEBUG=True: a API se recusa a subir com isto ligado e DEBUG=False.
# Remover quando o login real estiver configurado (ver apps/contas/dev_login.py).
DEV_LOGIN_ENABLED=false

# --- Cifragem de PII ---
# Gere as duas chaves (uma para cada variavel, valores diferentes) com:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#
# ATENCAO: guarde as chaves fora do servidor tambem. Perde-las torna os dados
# pessoais ja cifrados irrecuperaveis — nao ha como decifrar sem elas.
#
# Ao ligar numa base que ja tem cadastros, rode em seguida:
#   python manage.py cifrar_dados_pessoais
# Sem isso, os cadastros antigos ficam sem indice de busca e somem da consulta
# por CPF, NIS ou e-mail. Use --simular antes para ver quantos serao afetados.
PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=

# --- Pre-cadastro ---
PRECADASTRO_ENABLED=false
PRECADASTRO_CLIENT_ID=
PRECADASTRO_CLIENT_SECRET=

# --- Docker (producao) ---
POSTGRES_USER=sgcas
POSTGRES_PASSWORD=SENHA_FORTE_AQUI
POSTGRES_DB=sgcas
POSTGRES_PORT=5434
API_PORT=8000
# Interface em que a porta da API e publicada. Padrao 127.0.0.1: so o Next e o
# nginx desta maquina chegam a ela. Nunca use 0.0.0.0 em producao.
# API_BIND_ADDRESS=127.0.0.1
